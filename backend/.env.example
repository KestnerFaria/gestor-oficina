# Copie para ".env" e preencha. Nunca suba o ".env" pro Git.

# String de conexão do PostgreSQL (Railway/Render fornecem isso pronto)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/oficina

# Segredo usado para assinar os tokens de login (gere algo aleatório e longo)
JWT_SECRET=troque-por-uma-string-aleatoria-bem-longa

# Porta do servidor
PORT=3001

# Origem permitida para o front-end fazer requisições (CORS)
FRONTEND_URL=http://localhost:5173

# ---- Asaas (cobrança recorrente) ----
# Comece com a chave de Sandbox (começa com $aact_hmlg_) pra testar sem
# risco. Troque pela chave de Produção ($aact_prod_) só quando estiver
# tudo validado. Troque também a URL base junto.
ASAAS_API_KEY=$aact_hmlg_SUA_CHAVE_AQUI
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# token que você mesmo escolhe ao configurar o Webhook no painel do
# Asaas — usado pra confirmar que a notificação realmente veio de lá
ASAAS_WEBHOOK_TOKEN=escolha-um-texto-aleatorio-forte-aqui

# valor da mensalidade cobrada de cada oficina, em reais
VALOR_MENSALIDADE=100

