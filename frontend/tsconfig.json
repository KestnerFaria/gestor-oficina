{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vite/client"],

    // Migração gradual: arquivos .jsx continuam funcionando sem checagem
    // de tipos. Converta um componente por vez para .tsx.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "vite.config.ts"]
}
