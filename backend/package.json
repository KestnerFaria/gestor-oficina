{
  "name": "oficina-backend",
  "version": "1.0.0",
  "description": "API do sistema de gestão de oficina mecânica (multi-tenant)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
